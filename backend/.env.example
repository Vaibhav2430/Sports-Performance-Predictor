ODDS_API_KEY=your-odds-api-key-here

# Set production and list the exact HTTPS frontend origin(s) on the live host.
# Empty in development permits only the local development website addresses.
APP_ENV=development
CORS_ALLOWED_ORIGINS=

# Scheduler freshness checks default on in production, off during local use.
# Enable the same GitHub Actions repository variable after always-on hosting.
MONITOR_REQUIRE_SCHEDULER=false
MONITOR_STALE_JOB_SECONDS=10800
MONITOR_PENDING_GRACE_DAYS=3
MONITOR_LOW_CREDITS=50

# Set postgres ONLY after migrate_storage.py --apply succeeds. Supabase session
# pooler URI with a percent-encoded password, stored only on the backend.
STORAGE_BACKEND=local
DATABASE_URL=

# Automatic encrypted daily backups while the backend runs. Keep a separate
# password-manager copy of the key; losing it makes the archives unrecoverable.
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
# Optional dedicated read-only export connection, provisioned by setup_backups.py.
BACKUP_DATABASE_URL=
BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=30

# Admin-only bulk runs. Leave empty to disable the endpoint.
# Use a random token of at least 32 characters, stored only on the backend.
ADMIN_API_TOKEN=

# Used only in local mode. All backend workers must share this SQLite file on a persistent
# LOCAL volume. Empty uses backend/data_cache/api_usage.sqlite3.
# Postgres mode shares quotas through Supabase and ignores this path.
API_USAGE_DB=

PREDICTIONS_PER_IP_PER_MINUTE=10
PREDICTIONS_GLOBAL_PER_MINUTE=60
PREDICTIONS_GLOBAL_PER_HOUR=600
MAX_CONCURRENT_PREDICTIONS=2
ADMIN_BULK_RUNS_PER_HOUR=2
ENRICHMENT_PER_IP_PER_MINUTE=30
ENRICHMENT_GLOBAL_PER_MINUTE=120
MAX_CONCURRENT_ENRICHMENT_REQUESTS=4

# Free plan: 500 credits per calendar month, shared across both leagues.
# Scheduled work counts too. Event lists are free; event odds reserve up to
# three credits (one per requested market, one region). Provider usage headers
# include credits already spent elsewhere on the same account.
ODDS_API_MONTHLY_CREDIT_BUDGET=500
ODDS_CACHE_TTL_SECONDS=1800
